---
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
}

const { eyebrow, heading, body } = Astro.props;
---

<section class="cta section">
  <div class="container cta__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{heading}</h2>
    {body && <p class="cta__body">{body}</p>}
    <div class="cta__actions">
      <a class="btn btn--primary" href="/contact/">Get in Touch</a>
      <a class="btn btn--secondary" href="/media/">Hear the Band</a>
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
  }

  .cta__inner {
    max-width: 640px;
  }

  .cta__body {
    color: var(--color-text-muted);
  }

  .cta__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
