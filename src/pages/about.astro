---
import BaseLayout from '../layouts/BaseLayout.astro';

const reasons = [
  'Wide range of musical styles under one roof',
  'Experienced, professional musicians',
  'Easy booking and clear pricing',
  'Flexible for weddings, corporate events, private parties, and more',
];
---

<BaseLayout title="About" description="MidwestMusicICT connects you with a network of professional musicians for weddings, corporate events, and private celebrations.">
  <section class="section about-hero">
    <div class="container about-hero__grid">
      <div class="about-hero__photo card">
        <!-- TODO: replace with a real performance/ensemble photo once available -->
        <p class="about-hero__photo-placeholder">Photo coming soon</p>
      </div>
      <div>
        <p class="eyebrow">About</p>
        <h1>About MidwestMusicICT</h1>
        <p class="about-hero__body">
          MidwestMusicICT was built on a simple idea: every event deserves music that fits. We work
          with a network of skilled, professional musicians across a range of styles, so you&rsquo;re
          not stuck choosing between &ldquo;the DJ&rdquo; and &ldquo;the band&rdquo; &mdash; you get
          exactly the sound your event calls for, handled by people who do this for a living.
        </p>
        <p class="about-hero__body">
          From your first inquiry to the final encore, we handle the coordination, so you can focus on
          your guests instead of logistics.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Why Book With Us</p>
      <ul class="reasons-list">
        {reasons.map((reason) => (
          <li>{reason}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section founder">
    <div class="container founder__grid">
      <div class="founder__photo card">
        <!-- TODO: replace with a real photo of Kim once available -->
        <p class="founder__photo-placeholder">Photo of Kim Trujillo, Founder, coming soon</p>
      </div>
      <div>
        <p class="eyebrow">Meet the Founder</p>
        <h2>Kim Trujillo</h2>
        <!-- TODO: replace with Kim's real personal bio -->
        <p class="founder__body">
          Kim&rsquo;s personal bio is coming soon &mdash; her background in music, how
          MidwestMusicICT got started, and what drives her to connect clients with the right sound
          for their event.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero__grid {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .about-hero__photo {
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-text-muted);
  }

  .about-hero__body {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .reasons-list {
    max-width: 60ch;
    color: var(--color-text-muted);
    padding-left: 1.2rem;
  }

  .reasons-list li {
    margin-bottom: 0.6rem;
  }

  @media (max-width: 720px) {
    .about-hero__grid {
      grid-template-columns: 1fr;
    }
  }

  .founder__grid {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .founder__photo {
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-text-muted);
  }

  .founder__body {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  @media (max-width: 720px) {
    .founder__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
