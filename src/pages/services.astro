---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';

const services = [
  {
    title: 'Weddings',
    body: 'Ceremony, cocktail hour, and reception coverage. Choose from a solo performer, small ensemble, or full band depending on your venue and guest count.',
  },
  {
    title: 'Corporate Events',
    body: 'Galas, award dinners, holiday parties, and client events that call for polished, professional live music.',
  },
  {
    title: 'Private Parties',
    body: 'Anniversaries, milestone birthdays, and other private celebrations, sized to fit your space.',
  },
  {
    title: 'Other Celebrations',
    body: 'Have something else in mind? Reach out and we will help figure out the right musical fit.',
  },
];
---

<BaseLayout title="Services" description="midwestmusicICT provides live musicians for weddings, corporate events, private parties, and celebrations across the Wichita, Kansas area.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>Live music, matched to your event</h1>
      <p class="section-intro">
        <!-- TODO: replace with real package/pricing details once available -->
        Every event is different, so lineups and pricing are built around your date, venue, and vision.
        Below are the kinds of events we play most &mdash; get in touch for details specific to yours.
      </p>
      <div class="grid grid--2 services-grid">
        {services.map((service) => (
          <div class="card">
            <h3>{service.title}</h3>
            <p>{service.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">How Booking Works</p>
      <h2>From first message to showtime</h2>
      <ol class="steps">
        <li><strong>Reach out</strong> with your date, venue, and event type.</li>
        <li><strong>We build a lineup</strong> matched to your event and budget.</li>
        <li><strong>Confirm the details</strong> &mdash; song requests, timing, and logistics.</li>
        <li><strong>Enjoy the show</strong> and leave the music to us.</li>
      </ol>
    </div>
  </section>

  <CallToAction
    eyebrow="Have a date in mind?"
    heading="Check availability for your event"
  />
</BaseLayout>

<style>
  .section-intro {
    max-width: 70ch;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .services-grid {
    margin-top: 1rem;
  }

  .steps {
    max-width: 60ch;
    color: var(--color-text-muted);
    padding-left: 1.2rem;
  }

  .steps li {
    margin-bottom: 0.75rem;
  }

  .steps strong {
    color: var(--color-text);
  }
</style>
